{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .ai-location-selector-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ section.settings.background_color }};
  }

  .ai-location-selector__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-location-selector__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-location-selector__title-{{ ai_gen_id }} {
    font-size: {{ section.settings.title_size }}px;
    color: {{ section.settings.text_color }};
    margin: 0 0 12px;
  }

  .ai-location-selector__subtitle-{{ ai_gen_id }} {
    font-size: {{ section.settings.subtitle_size }}px;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
    margin: 0;
  }

  .ai-location-selector__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
    margin-bottom: 40px;
  }

  .ai-location-card-{{ ai_gen_id }} {
    background-color: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-location-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .ai-location-card__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: {{ section.settings.image_height }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-location-card__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-location-card__image-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-location-card__content-{{ ai_gen_id }} {
    padding: 24px;
  }

  .ai-location-card__name-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 600;
    color: {{ section.settings.text_color }};
    margin: 0 0 12px;
  }

  .ai-location-card__info-{{ ai_gen_id }} {
    margin-bottom: 16px;
  }

  .ai-location-card__info-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 8px;
    font-size: 14px;
    color: {{ section.settings.text_color }};
    opacity: 0.9;
  }

  .ai-location-card__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-top: 2px;
  }

  .ai-location-card__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ section.settings.accent_color }};
  }

  .ai-location-card__hours-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
    margin-bottom: 16px;
    padding-top: 12px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .ai-location-card__button-{{ ai_gen_id }} {
    display: inline-block;
    width: 100%;
    padding: 12px 24px;
    background-color: {{ section.settings.button_color }};
    color: {{ section.settings.button_text_color }};
    text-align: center;
    text-decoration: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-location-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ section.settings.button_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-location-selector__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-location-selector__title-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.title_size }}px * 0.8);
    }
  }
{% endstyle %}

<location-selector-{{ ai_gen_id }} class="ai-location-selector-{{ ai_gen_id }}">
  <div class="ai-location-selector__container-{{ ai_gen_id }}">
    {% if section.settings.title != blank or section.settings.subtitle != blank %}
      <div class="ai-location-selector__header-{{ ai_gen_id }}">
        {% if section.settings.title != blank %}
          <h2 class="ai-location-selector__title-{{ ai_gen_id }}">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="ai-location-selector__subtitle-{{ ai_gen_id }}">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-location-selector__grid-{{ ai_gen_id }}">
      {% for block in section.blocks %}
        {% if block.type == 'location' %}
          <div class="ai-location-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
            <div class="ai-location-card__image-wrapper-{{ ai_gen_id }}">
              {% if block.settings.image %}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.name | escape }}"
                  loading="lazy"
                  width="600"
                  height="{{ section.settings.image_height }}"
                  class="ai-location-card__image-{{ ai_gen_id }}"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>

            <div class="ai-location-card__content-{{ ai_gen_id }}">
              <h3 class="ai-location-card__name-{{ ai_gen_id }}">{{ block.settings.name }}</h3>

              <div class="ai-location-card__info-{{ ai_gen_id }}">
                {% if block.settings.address != blank %}
                  <div class="ai-location-card__info-item-{{ ai_gen_id }}">
                    <span class="ai-location-card__icon-{{ ai_gen_id }}">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                      </svg>
                    </span>
                    <span>{{ block.settings.address }}</span>
                  </div>
                {% endif %}

                {% if block.settings.phone != blank %}
                  <div class="ai-location-card__info-item-{{ ai_gen_id }}">
                    <span class="ai-location-card__icon-{{ ai_gen_id }}">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                      </svg>
                    </span>
                    <span>{{ block.settings.phone }}</span>
                  </div>
                {% endif %}
              </div>

              {% if block.settings.hours != blank %}
                <div class="ai-location-card__hours-{{ ai_gen_id }}">
                  {{ block.settings.hours }}
                </div>
              {% endif %}

              {% if block.settings.url != blank %}
                <a href="{{ block.settings.url }}" class="ai-location-card__button-{{ ai_gen_id }}">
                  {{ section.settings.button_text }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</location-selector-{{ ai_gen_id }}>

<script>
  (function() {
    class LocationSelector{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const cards = this.querySelectorAll('.ai-location-card-{{ ai_gen_id }}');
        cards.forEach(card => {
          card.addEventListener('click', (e) => {
            if (e.target.tagName !== 'A') {
              const link = card.querySelector('.ai-location-card__button-{{ ai_gen_id }}');
              if (link) {
                link.click();
              }
            }
          });
        });
      }
    }

    customElements.define('location-selector-{{ ai_gen_id }}', LocationSelector{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Location selector",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our Locations"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Visit us or order from your nearest location"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Order Now"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 120,
      "max": 300,
      "step": 20,
      "unit": "px",
      "label": "Image height",
      "default": 200
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 36
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle size",
      "default": 16
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#f1f1f1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#e67e22"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#e67e22"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover",
      "default": "#d35400"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Location Name"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "123 Main Street, City, State 12345"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Hours",
          "default": "Mon-Fri: 7am-6pm, Sat-Sun: 8am-5pm"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Order link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Location selector",
      "blocks": [
        { "type": "location" },
        { "type": "location" }
      ]
    }
  ]
}
{% endschema %}
