{% doc %}
  @prompt
    Create a way for customers to view and order from all of our locations, add a small image to each location
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-location-selector-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-location-selector__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-location-selector__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-location-selector__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
  }

  .ai-location-selector__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
  }

  .ai-location-selector__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
    margin-bottom: 40px;
  }

  .ai-location-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-location-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .ai-location-card__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-location-card__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-location-card__image-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-location-card__content-{{ ai_gen_id }} {
    padding: 24px;
  }

  .ai-location-card__name-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
  }

  .ai-location-card__info-{{ ai_gen_id }} {
    margin-bottom: 16px;
  }

  .ai-location-card__info-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 8px;
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.9;
  }

  .ai-location-card__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-top: 2px;
  }

  .ai-location-card__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.accent_color }};
  }

  .ai-location-card__hours-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin-bottom: 16px;
    padding-top: 12px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .ai-location-card__button-{{ ai_gen_id }} {
    display: inline-block;
    width: 100%;
    padding: 12px 24px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-align: center;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-location-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-location-selector__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-location-selector__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }
  }
{% endstyle %}

<location-selector-{{ ai_gen_id }} class="ai-location-selector-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-location-selector__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-location-selector__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-location-selector__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-location-selector__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-location-selector__grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign location_enabled_key = 'location_' | append: i | append: '_enabled'
          assign location_name_key = 'location_' | append: i | append: '_name'
          assign location_image_key = 'location_' | append: i | append: '_image'
          assign location_address_key = 'location_' | append: i | append: '_address'
          assign location_phone_key = 'location_' | append: i | append: '_phone'
          assign location_hours_key = 'location_' | append: i | append: '_hours'
          assign location_url_key = 'location_' | append: i | append: '_url'

          assign location_enabled = block.settings[location_enabled_key]
          assign location_name = block.settings[location_name_key]
          assign location_image = block.settings[location_image_key]
          assign location_address = block.settings[location_address_key]
          assign location_phone = block.settings[location_phone_key]
          assign location_hours = block.settings[location_hours_key]
          assign location_url = block.settings[location_url_key]
        %}

        {% if location_enabled and location_name != blank %}
          <div class="ai-location-card-{{ ai_gen_id }}">
            <div class="ai-location-card__image-wrapper-{{ ai_gen_id }}">
              {% if location_image %}
                <img
                  src="{{ location_image | image_url: width: 600 }}"
                  alt="{{ location_name | escape }}"
                  loading="lazy"
                  width="600"
                  height="{{ block.settings.image_height }}"
                  class="ai-location-card__image-{{ ai_gen_id }}"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>

            <div class="ai-location-card__content-{{ ai_gen_id }}">
              <h3 class="ai-location-card__name-{{ ai_gen_id }}">{{ location_name }}</h3>
              
              <div class="ai-location-card__info-{{ ai_gen_id }}">
                {% if location_address != blank %}
                  <div class="ai-location-card__info-item-{{ ai_gen_id }}">
                    <span class="ai-location-card__icon-{{ ai_gen_id }}">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                      </svg>
                    </span>
                    <span>{{ location_address }}</span>
                  </div>
                {% endif %}

                {% if location_phone != blank %}
                  <div class="ai-location-card__info-item-{{ ai_gen_id }}">
                    <span class="ai-location-card__icon-{{ ai_gen_id }}">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                      </svg>
                    </span>
                    <span>{{ location_phone }}</span>
                  </div>
                {% endif %}
              </div>

              {% if location_hours != blank %}
                <div class="ai-location-card__hours-{{ ai_gen_id }}">
                  {{ location_hours }}
                </div>
              {% endif %}

              {% if location_url != blank %}
                <a href="{{ location_url }}" class="ai-location-card__button-{{ ai_gen_id }}">
                  {{ block.settings.button_text }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</location-selector-{{ ai_gen_id }}>

<script>
  (function() {
    class LocationSelector{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const cards = this.querySelectorAll('.ai-location-card-{{ ai_gen_id }}');
        cards.forEach(card => {
          card.addEventListener('click', (e) => {
            if (e.target.tagName !== 'A') {
              const link = card.querySelector('.ai-location-card__button-{{ ai_gen_id }}');
              if (link) {
                link.click();
              }
            }
          });
        });
      }
    }

    customElements.define('location-selector-{{ ai_gen_id }}', LocationSelector{{ ai_gen_id }});
  })();
</script>

